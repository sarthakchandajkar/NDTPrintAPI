@page "/"
@inject HttpClient Http

<div class="container">
    <h1>NDT Bundle Service – Test UI</h1>

    <div class="card">
        <div class="form-group">
            <label for="baseUrl">Service URL</label>
            <input id="baseUrl" type="text" @bind="baseUrl" placeholder="http://localhost:5000" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="poNumber">PO Number</label>
                <input id="poNumber" type="text" @bind="poNumber" placeholder="e.g. 1000055673" />
            </div>
            <div class="form-group">
                <label for="millNo">Mill No</label>
                <select id="millNo" @bind="millNo">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>
        </div>
        <button class="btn btn-primary" @onclick="SimulatePoEnd" disabled="@isBusy">
            Simulate PO End
        </button>
        <div class="status @(isError ? "error" : "")">@statusText</div>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <strong>WIP data and NDT pipe count</strong>
            <button class="btn btn-secondary" @onclick="RefreshStatus" disabled="@isBusy">Refresh</button>
        </div>

        @if (wip is null)
        {
            <p>No WIP data loaded yet.</p>
        }
        else
        {
            <table class="table">
                <tbody>
                    <tr><th>PO Number</th><td>@wip.PoNumber</td></tr>
                    <tr><th>Mill Number</th><td>@wip.MillNumber</td></tr>
                    <tr><th>Planned Month</th><td>@wip.PlannedMonth</td></tr>
                    <tr><th>Pipe Grade</th><td>@wip.PipeGrade</td></tr>
                    <tr><th>Pipe Size</th><td>@wip.PipeSize</td></tr>
                    <tr><th>Pipe Thickness</th><td>@wip.PipeThickness</td></tr>
                    <tr><th>Pipe Length</th><td>@wip.PipeLength</td></tr>
                    <tr><th>Pieces Per Bundle</th><td>@wip.PiecesPerBundle</td></tr>
                    <tr><th>Total Pieces</th><td>@wip.TotalPieces</td></tr>
                </tbody>
            </table>
        }

        <div style="margin-top: 0.75rem;">
            <strong>Current NDT pipes produced for this PO / mill:</strong>
            @if (summary is null)
            {
                <span> not loaded.</span>
            }
            else
            {
                <span> @summary.TotalNdtPipes</span>
            }
        </div>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <strong>Generated bundle CSV files</strong>
            <button class="btn btn-secondary" @onclick="RefreshBundles" disabled="@isBusy">Refresh list</button>
        </div>
        @if (bundles.Count == 0)
        {
            <ul class="bundle-list empty">
                <li>No bundle files yet. Ensure NdtBundleService is running and Simulate PO End has been used.</li>
            </ul>
        }
        else
        {
            <ul class="bundle-list">
                @foreach (var b in bundles)
                {
                    <li>@b.FileName</li>
                }
            </ul>
        }
    </div>

    <div class="card">
        <h3>Manual NDT Input Slit output</h3>
        <p class="text-muted">
            Creates a CSV in the NDT Input Slit output folder with NDT Batch No and records Output_Slit_Row.
            File name is always SlitNumber_YYMMDD_PONumber (YYMMDD from Slit Start Time).
            Times must be dd.MM.yyyy HH:mm:ss (e.g. 27.09.2026 14:53:31). Does not write to the SAP inbox.
        </p>
        <div class="form-row">
            <div class="form-group">
                <label for="manualPo">PO Number</label>
                <input id="manualPo" type="text" @bind="manualPo" placeholder="e.g. 1000055673" />
            </div>
            <div class="form-group">
                <label for="manualMill">Mill No</label>
                <select id="manualMill" @bind="manualMill">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>
            <div class="form-group">
                <label for="manualBatchNo">NDT Batch No</label>
                <input id="manualBatchNo" type="text" @bind="manualBatchNo" placeholder="Required" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="manualSlitNo">Slit No</label>
                <input id="manualSlitNo" type="text" @bind="manualSlitNo" placeholder="Required (file name segment)" />
            </div>
            <div class="form-group">
                <label for="manualNdt">NDT Pipes</label>
                <input id="manualNdt" type="number" min="0" @bind="manualNdt" />
            </div>
            <div class="form-group">
                <label for="manualRejected">Rejected P</label>
                <input id="manualRejected" type="number" min="0" @bind="manualRejected" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="manualStart">Slit Start Time</label>
                <input id="manualStart" type="text" @bind="manualStart" @bind:event="oninput"
                       placeholder="27.09.2026 14:53:31" autocomplete="off" spellcheck="false"
                       title="Paste or type dd.MM.yyyy HH:mm:ss" />
                <span class="text-muted" style="font-size:0.8rem;">Paste dd.MM.yyyy HH:mm:ss directly</span>
            </div>
            <div class="form-group">
                <label for="manualFinish">Slit Finish Time</label>
                <input id="manualFinish" type="text" @bind="manualFinish" @bind:event="oninput"
                       placeholder="27.09.2026 14:53:31" autocomplete="off" spellcheck="false"
                       title="Paste or type dd.MM.yyyy HH:mm:ss" />
                <span class="text-muted" style="font-size:0.8rem;">Paste dd.MM.yyyy HH:mm:ss directly</span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="manualShort">NDT Short Length Pipe</label>
                <input id="manualShort" type="text" @bind="manualShort" />
            </div>
            <div class="form-group">
                <label for="manualRejShort">Rejected Short Length Pipe</label>
                <input id="manualRejShort" type="text" @bind="manualRejShort" />
            </div>
        </div>
        <button class="btn btn-primary" @onclick="CreateManualInputSlit" disabled="@isBusy">
            Create NDT Input Slit CSV
        </button>
        <div class="status @(manualError ? "error" : "")" style="margin-top: 0.5rem;">@manualStatus</div>
    </div>

    <div class="card">
        <h3>Reconcile Bundle</h3>
        <p class="text-muted">
            Primary tool when the printed tag count is wrong or pipes attached to the wrong batch.
            Select the NDT Batch No., enter the corrected plant count, and reconcile — this updates the UI, reprints the tag, and updates CSV/SQL.
            If the CSV never arrived (or arrived too early and still has no batch), use Manual Input Slit above after the tag exists.
        </p>
        <div class="form-row">
            <div class="form-group">
                <label for="reconcileBatchNo">NDT Batch No.</label>
                <select id="reconcileBatchNo" @bind="reconcileBatchNo" @bind:after="OnReconcileBatchNoChanged" class="form-control">
                    <option value="">-- Select bundle --</option>
                    @foreach (var b in reconcileBundles)
                    {
                        <option value="@b.BundleNo">
                            @b.BundleNo (PO: @b.PoNumber, Mill: @b.MillNo, current: @b.TotalNdtPcs pcs@(b.CountDiscrepancy || string.Equals(b.CsvFillState, "CsvOvershoot", StringComparison.OrdinalIgnoreCase) ? ", OVERSHOOT" : ""))
                        </option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="newNdtPipes">New NDT Pipes (correct count)</label>
                <input id="newNdtPipes" type="number" min="0" @bind="newNdtPipes" class="form-control" placeholder="e.g. 10" />
            </div>
        </div>
        @if (SelectedReconcileBundleIsOvershoot)
        {
            <p class="status error" style="margin-top: 0.5rem;">
                Overshoot: CSV stamped pipes exceed this tag total. Reconcile slit counts below (or use Manual Reconcile).
                Inbox Input Slit files are updated on disk; SAP-Accepted files update SQL only (Accepted file unchanged).
            </p>
        }
        <button class="btn btn-primary" @onclick="ReconcileBundle" disabled="@(isBusy || string.IsNullOrEmpty(reconcileBatchNo) || newNdtPipes < 0)">
            Reconcile Bundle
        </button>
        <div class="status @(reconcileError ? "error" : "")" style="margin-top: 0.5rem;">@reconcileStatus</div>
    </div>

    <p class="footer">Ensure NdtBundleService is running (dotnet run --project src\\NdtBundleService\\NdtBundleService.csproj).</p>
</div>

@code {
    private string baseUrl = "http://localhost:5000";
    private string poNumber = "";
    private int millNo = 1;
    private string statusText = "";
    private bool isBusy;
    private bool isError;
    private List<BundleFileInfo> bundles = new();
    private WipInfo? wip;
    private NdtSummary? summary;

    private List<ReconcileBundleItem> reconcileBundles = new();
    private string reconcileBatchNo = "";
    private int newNdtPipes;
    private string reconcileStatus = "";
    private bool reconcileError;

    private string manualPo = "";
    private int manualMill = 1;
    private string manualSlitNo = "";
    private int manualNdt;
    private int manualRejected;
    private string manualBatchNo = "";
    private string manualStart = "";
    private string manualFinish = "";
    private string manualShort = "";
    private string manualRejShort = "";
    private string manualStatus = "";
    private bool manualError;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatus();
        await RefreshBundles();
        await RefreshReconcileBundles();
    }

    private void OnReconcileBatchNoChanged()
    {
        var b = reconcileBundles.FirstOrDefault(x => x.BundleNo == reconcileBatchNo);
        if (b != null)
            newNdtPipes = b.TotalNdtPcs;
    }

    private async Task RefreshReconcileBundles()
    {
        try
        {
            var url = baseUrl.TrimEnd('/') + "/api/Reconcile/bundles";
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var list = await Http.GetFromJsonAsync<List<ReconcileBundleItem>>(url, options);
            reconcileBundles = list ?? new List<ReconcileBundleItem>();
        }
        catch
        {
            reconcileBundles = new List<ReconcileBundleItem>();
        }
    }

    private async Task CreateManualInputSlit()
    {
        var po = manualPo?.Trim() ?? "";
        var batch = manualBatchNo?.Trim() ?? "";
        var slitNo = manualSlitNo?.Trim() ?? "";
        var start = manualStart?.Trim() ?? "";
        var finish = manualFinish?.Trim() ?? "";
        if (string.IsNullOrEmpty(po))
        {
            manualStatus = "Please enter a PO Number.";
            manualError = true;
            return;
        }
        if (string.IsNullOrEmpty(slitNo))
        {
            manualStatus = "Please enter a Slit No.";
            manualError = true;
            return;
        }
        if (string.IsNullOrEmpty(batch))
        {
            manualStatus = "Please enter an NDT Batch No.";
            manualError = true;
            return;
        }
        if (string.IsNullOrEmpty(start) || string.IsNullOrEmpty(finish))
        {
            manualStatus = "Slit Start and Finish Time are required (dd.MM.yyyy HH:mm:ss).";
            manualError = true;
            return;
        }

        isBusy = true;
        manualError = false;
        manualStatus = "Creating NDT Input Slit CSV…";

        try
        {
            var url = baseUrl.TrimEnd('/') + "/api/InputSlits/manual";
            var body = new
            {
                PoNumber = po,
                MillNo = manualMill,
                SlitNo = slitNo,
                NdtPipes = manualNdt,
                RejectedPipes = manualRejected,
                SlitStartTime = start,
                SlitFinishTime = finish,
                NdtShortLengthPipe = manualShort,
                RejectedShortLengthPipe = manualRejShort,
                NdtBatchNo = batch
            };
            var response = await Http.PostAsJsonAsync(url, body);
            var text = await response.Content.ReadAsStringAsync();
            if (response.IsSuccessStatusCode)
            {
                manualStatus = text;
                manualError = false;
            }
            else
            {
                manualStatus = $"Error {(int)response.StatusCode}: {text}";
                manualError = true;
            }
        }
        catch (Exception ex)
        {
            manualStatus = "Error: " + ex.Message;
            manualError = true;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ReconcileBundle()
    {
        if (string.IsNullOrWhiteSpace(reconcileBatchNo))
        {
            reconcileStatus = "Please select an NDT Batch No.";
            reconcileError = true;
            return;
        }

        isBusy = true;
        reconcileError = false;
        reconcileStatus = "Reconciling...";

        try
        {
            var url = baseUrl.TrimEnd('/') + "/api/Reconcile/reconcile";
            var body = new { NdtBatchNo = reconcileBatchNo, NewNdtPipes = newNdtPipes };
            var response = await Http.PostAsJsonAsync(url, body);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ReconcileResult>(new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                reconcileStatus = result?.Message ?? "Bundle reconciled.";
                await RefreshReconcileBundles();
                await RefreshBundles();
                await RefreshStatus();
            }
            else
            {
                var bodyText = await response.Content.ReadAsStringAsync();
                reconcileStatus = $"Error {(int)response.StatusCode}: {bodyText}";
                reconcileError = true;
            }
        }
        catch (Exception ex)
        {
            reconcileStatus = "Error: " + ex.Message;
            reconcileError = true;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SimulatePoEnd()
    {
        var po = poNumber?.Trim() ?? "";
        if (string.IsNullOrEmpty(po))
        {
            statusText = "Please enter a PO Number.";
            isError = true;
            return;
        }

        isBusy = true;
        isError = false;
            statusText = "Calling Simulate PO End...";

        try
        {
            var url = baseUrl.TrimEnd('/') + "/api/Test/po-end";
            var body = new { PoNumber = po, MillNo = millNo };
            var response = await Http.PostAsJsonAsync(url, body);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PoEndResult>();
                statusText = result?.Message ?? "PO end simulated successfully.";
                await RefreshStatus();
                await RefreshBundles();
            }
            else
            {
                var bodyText = await response.Content.ReadAsStringAsync();
                statusText = $"Error {(int)response.StatusCode}: {bodyText}";
                isError = true;
            }
        }
        catch (HttpRequestException ex)
        {
            statusText = $"Cannot reach service at {baseUrl}. Is NdtBundleService running? {ex.Message}";
            isError = true;
        }
        catch (Exception ex)
        {
            statusText = "Error: " + ex.Message;
            isError = true;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RefreshBundles()
    {
        isBusy = true;
        try
        {
            var url = baseUrl.TrimEnd('/') + "/api/Test/bundles";
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var list = await Http.GetFromJsonAsync<List<BundleFileInfo>>(url, options);
            bundles = list ?? new List<BundleFileInfo>();
            if (!isError)
                statusText = bundles.Count > 0 ? $"Found {bundles.Count} bundle file(s)." : "No bundle files yet.";
        }
        catch
        {
            if (bundles.Count == 0)
                statusText = $"Cannot reach service at {baseUrl}. Start NdtBundleService first.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RefreshStatus()
    {
        isBusy = true;
        try
        {
            var root = baseUrl.TrimEnd('/');

            // Load WIP info (from WIP CSV)
            try
            {
                var wipUrl = root + "/api/Test/wip-info";
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                wip = await Http.GetFromJsonAsync<WipInfo>(wipUrl, options);
                if (wip is not null && string.IsNullOrWhiteSpace(poNumber))
                {
                    // Default PO text box from WIP file if empty
                    poNumber = wip.PoNumber ?? "";
                }
            }
            catch
            {
                // Ignore; UI will just show "not loaded"
            }

            // Load current NDT pipe count summary for the entered PO/mill
            try
            {
                var po = (poNumber ?? string.Empty).Trim();
                if (!string.IsNullOrEmpty(po))
                {
                    var summaryUrl = root + $"/api/Test/ndt-summary?poNumber={Uri.EscapeDataString(po)}&millNo={millNo}";
                    var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    summary = await Http.GetFromJsonAsync<NdtSummary>(summaryUrl, options);
                }
            }
            catch
            {
                // Ignore; UI will just show "not loaded"
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class PoEndResult
    {
        public string? Message { get; set; }
    }

    private sealed class BundleFileInfo
    {
        public string? FileName { get; set; }
        public string? FullPath { get; set; }
    }

    private sealed class WipInfo
    {
        public string? PoNumber { get; set; }
        public string? MillNumber { get; set; }
        public string? PlannedMonth { get; set; }
        public string? PipeGrade { get; set; }
        public string? PipeSize { get; set; }
        public string? PipeThickness { get; set; }
        public string? PipeLength { get; set; }
        public string? PipeWeightPerMeter { get; set; }
        public string? PipeType { get; set; }
        public string? OutputItemcode { get; set; }
        public string? ItemDescription { get; set; }
        public string? TotalPieces { get; set; }
        public string? PiecesPerBundle { get; set; }
        public string? ProductType { get; set; }
        public string? POSpecification { get; set; }
        public string? InputWipItemcode { get; set; }
    }

    private sealed class NdtSummary
    {
        public string? PoNumber { get; set; }
        public int MillNo { get; set; }
        public int TotalNdtPipes { get; set; }
    }

    private sealed class ReconcileBundleItem
    {
        public string? BundleNo { get; set; }
        public string? PoNumber { get; set; }
        public int MillNo { get; set; }
        public int TotalNdtPcs { get; set; }
        public string? SlitNo { get; set; }
        public bool CountDiscrepancy { get; set; }
        public string? CsvFillState { get; set; }
        public int CsvFilled { get; set; }
        public int? TargetNdtPcs { get; set; }
    }

    private bool SelectedReconcileBundleIsOvershoot
    {
        get
        {
            var b = reconcileBundles.FirstOrDefault(x =>
                string.Equals(x.BundleNo, reconcileBatchNo, StringComparison.OrdinalIgnoreCase));
            if (b is null)
                return false;
            return b.CountDiscrepancy
                   || string.Equals(b.CsvFillState, "CsvOvershoot", StringComparison.OrdinalIgnoreCase);
        }
    }

    private sealed class ReconcileResult
    {
        public string? Message { get; set; }
    }
}
