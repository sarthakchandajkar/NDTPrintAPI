graph TD
    subgraph ext [External Systems]
        SAP_IN[SAP file shares Input Slit PO WIP]
        PLC1[S7 PLC Mill-1]
        PLC2[S7 PLC Mill-2]
        PLC3[S7 PLC Mill-3]
        PLC4[S7 PLC Mill-4]
        SQL[SQL Server JazeeraMES_Prod]
        ZPL[ZPL printer port 9100]
    end

    subgraph ui [Presentation]
        DASH[ndtbundle-dashboard]
        API[ASP.NET REST API]
    end

    subgraph workers [Background Workers]
        PHW[PlcHandshakeWorker]
        SMW[SlitMonitoringWorker]
        FBPW[FileBasedPoChangeWorker]
        UPL[UploadNdtBundleScheduler]
        POIMP[PoPlanWipImport]
    end

    subgraph domain [Business Logic]
        ENG[NdtBundleEngine]
        POWF[PoEndWorkflowService]
        BATCH[NdtBatchStateService]
        STATE[NdtBundleRuntimeStateStore]
        WIPPO[WipBundleRunningPoProvider]
    end

    subgraph infra [Infrastructure]
        S7HS[PlcHandshakeService]
        S7NDT[S7MillNdtCountReader]
        CSVW[CsvBundleOutputWriter]
        ZPLP[NdtZplTagPrinter]
        NETP[NetworkPrinterSender]
        TRACE[TraceabilityRepository]
        BREPO[NdtBundleRepository]
        POPLAN[PoPlanWipRepository]
    end

    subgraph legacy [Legacy NDTPrintApi]
        LAPI[NDTPrintApi]
        LDB[Legacy bundle tables]
    end

    SAP_IN --> SMW
    SAP_IN --> WIPPO
    SAP_IN --> POIMP

    WIPPO --> FBPW
