    NETP --> ZPL

    SMW --> TRACE
    CSVW --> TRACE
    POIMP --> POPLAN
    POPLAN --> SQL
    BREPO --> SQL
    TRACE --> SQL

    PLC1 --> S7HS
    PLC2 --> S7HS
    PLC3 --> S7HS
    PLC4 --> S7HS
    S7HS --> PLC1
    S7HS --> PLC2
    S7HS --> PLC3
    S7HS --> PLC4
    S7NDT --> PLC3
    PLC3 --> S7NDT
    SMW --> S7NDT

    PHW --> S7HS

    DASH --> API
